   ],
   labels: [] },
];

// ── 描画 ─────────────────────────────────────────────────
const el = (tag, attrs, parent) => {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  parent.appendChild(e); return e;
};
const levelGs = LEVELS.map((L, li) => {
  const g = el('g', { class: 'level' }, svg);           // 全体 (scale/fade 用)
  const aux = el('g', { class: 'aux' }, g);             // wash / edge / label
  for (const w of L.washes || []) {
    if (w.r) el('circle', { class: w.cls, cx: w.cx, cy: w.cy, r: w.r }, aux);
    else el('rect', { class: w.cls, x: w.x, y: w.y, width: w.w, height: w.h }, aux);
    if (w.label) { const t = el('text', { class: 'grpl', x: w.lx, y: w.ly }, aux); t.textContent = w.label; }
  }
  const eps = (L.edges || []).map(e2 => el('path', { class: 'ar' + (e2.cls ? ' ' + e2.cls : ''), d: e2.d }, aux));
  for (const lb of L.labels || []) {
    const t = el('text', { class: 'al', x: lb.x, y: lb.y }, aux);
    if (lb.shu) t.setAttribute('style', 'fill:#B33A2B');
    t.textContent = lb.s;
  }
  const ndsG = el('g', {}, g);
  const nds = (L.nodes || []).map(n => {
    const ng = el('g', { class: 'nd' + (n.big ? ' big' : '') + (n.dim ? ' dim' : '') + (n.exp != null ? ' exp' : '') + (n.info ? ' info' : '') + (n.exit ? ' exit' : '') + (n.back != null ? ' exp backnd' : '') }, ndsG);
    const lineH = (n.lines || []).length;
    const act = n.exp != null || n.info || n.back != null;
    const hw = act ? 85 : 80, hh = (act ? 64 : 44) + lineH * 15;
    el('rect', { class: 'hit', x: -hw, y: -28, width: hw * 2, height: hh }, ng);
    if (n.cnr) {
      const [x1, y1, x2, y2] = n.cnr;
      el('path', { class: 'cnr', d: `M${x1} ${y1+11} L${x1} ${y1} L${x1+11} ${y1} M${x2-11} ${y1} L${x2} ${y1} L${x2} ${y1+11} M${x2} ${y2-11} L${x2} ${y2} L${x2-11} ${y2} M${x1+11} ${y2} L${x1} ${y2} L${x1} ${y2-11}` }, ng);
    }
    const t = el('text', { class: 't', y: 0 }, ng);
    t.textContent = n.t;
    if (n.exp != null) { const c = document.createElementNS(NS, 'tspan'); c.setAttribute('class', 'chev'); c.setAttribute('dx', '6'); c.textContent = '▸'; t.appendChild(c); }
    else if (n.info) { const c = document.createElementNS(NS, 'tspan'); c.setAttribute('class', 'plus'); c.setAttribute('dx', '6'); c.textContent = '＋'; t.appendChild(c); }
    if (n.m) { const m = el('text', { class: 'm', y: 20 }, ng); m.textContent = n.m; }
    (n.lines || []).forEach((s, i) => { const li = el('text', { class: 'li', y: 22 + i * 15 }, ng); li.textContent = s; });
    if (n.exp != null || n.info || n.back != null) {
      ng.setAttribute('tabindex', 0); ng.setAttribute('role', 'button');
      const go = e4 => {
        if (e4) e4.stopPropagation();
        if (n.back != null) nav(n.back, null);
        else if (n.exp != null) nav(n.exp, { x: n.x, y: n.y });
        else showPop(n);
      };
      ng.addEventListener('click', go);
      ng.addEventListener('keydown', e3 => { if (e3.key === 'Enter' || e3.key === ' ') { e3.preventDefault(); go(); } });
    }
    return { n, ng };
  });
  return { L, g, aux, nds, eps };
});

// ── エッジのトリム ───────────────────────────────────────
// 手打ちのエッジ座標はノードのテキスト量を知らないため、描画後に各エッジの
// 両端をノードテキスト bbox (+pad) の外へ機械的に切り詰めて文字被りを防ぐ。
// パスを 2px 間隔でサンプリングし polyline として再構成する (曲線もそのまま通る)。
function trimEdges() {
  const PAD = 6;
  for (const lg of levelGs) {
    const prevDisp = lg.g.style.display;
    lg.g.style.display = '';                       // display:none だと getBBox が 0 になる
    const boxes = [];
    for (const { n, ng } of lg.nds) {
      let b = null;
      for (const t of ng.querySelectorAll('text')) {
        const bb = t.getBBox();
        if (!bb.width && !bb.height) continue;
        b = b
          ? [Math.min(b[0], bb.x), Math.min(b[1], bb.y), Math.max(b[2], bb.x + bb.width), Math.max(b[3], bb.y + bb.height)]
          : [bb.x, bb.y, bb.x + bb.width, bb.y + bb.height];
      }
      // コーナー囲い (cnr) はテキストより外に出るので clearance に含める
      if (n.cnr) {
        const [cx1, cy1, cx2, cy2] = n.cnr;
        b = b
          ? [Math.min(b[0], cx1), Math.min(b[1], cy1), Math.max(b[2], cx2), Math.max(b[3], cy2)]
          : [cx1, cy1, cx2, cy2];
      }
      // text は node-local 座標 (transform 非依存) なので n.x/n.y を足す
      if (b) boxes.push([n.x + b[0] - PAD, n.y + b[1] - PAD, n.x + b[2] + PAD, n.y + b[3] + PAD]);
    }
    const inside = (x, y) => boxes.some(b => x > b[0] && x < b[2] && y > b[1] && y < b[3]);
    for (const p of lg.eps) {
      if (!p.dataset.d0) p.dataset.d0 = p.getAttribute('d');
      p.setAttribute('d', p.dataset.d0);           // font 読み込み後の再トリムに備え原型から
      const len = p.getTotalLength();
      if (!len) continue;
      const nSeg = Math.max(2, Math.ceil(len / 2));
      const pts = [];
      for (let i = 0; i <= nSeg; i++) { const q = p.getPointAtLength(len * i / nSeg); pts.push([q.x, q.y]); }
      let a = 0, b = pts.length - 1;
      while (a < b && inside(pts[a][0], pts[a][1])) a++;
      while (b > a && inside(pts[b][0], pts[b][1])) b--;
      if (b - a < 3) continue;                     // ほぼ丸ごと箱内なら手を付けない
      p.setAttribute('d', 'M' + pts.slice(a, b + 1).map(q => q[0].toFixed(1) + ' ' + q[1].toFixed(1)).join('L'));
    }
    lg.g.style.display = prevDisp;
  }
}
trimEdges();
// webfont 適用でテキスト幅が変わるため確定後にもう一度
if (document.fonts && document.fonts.ready) document.fonts.ready.then(trimEdges);

// ── スプリング (臨界減衰、現在値+速度から常に retarget 可能) ──
const springs = [];
function mkSpring(v, response) {
  const s = { v, vel: 0, t: v, w: 2 * Math.PI / response };
  springs.push(s); return s;
}
function stepSprings(dt) {
  for (const s of springs) {
    if (reduced) { s.v = s.t; s.vel = 0; continue; }
    const a = -2 * s.w * s.vel - s.w * s.w * (s.v - s.t);
    s.vel += a * dt; s.v += s.vel * dt;
    if (Math.abs(s.v - s.t) < 1e-3 && Math.abs(s.vel) < 1e-3) { s.v = s.t; s.vel = 0; }
  }
}

// レベルごとの駆動値: zoom (1=通常, 1.55=奥へ抜けた), fade, ノード progress
const drv = levelGs.map((lg, li) => ({
  zoom: mkSpring(1, .55),
  fade: mkSpring(li === 0 ? 1 : 0, .4),
  nodeP: lg.nds.map(() => mkSpring(li === 0 ? 1 : 0, .38)),
  auxO: mkSpring(li === 0 ? 1 : 0, .45),
  origin: { x: 490, y: 250 },
}));

let cur = 0;
let pendingStagger = [];  // {spring, at}

// ── 概要 popover ─────────────────────────────────────────
const INFO = {
  tatara:  { t:'tatara', s:'github.com/SH11235/tatara',
             d:'NNUE 評価関数の学習ツール。手で fusion した CUDA カーネルで爆速。bullet-shogi から発展。',
             url:'https://github.com/SH11235/tatara' },
  nnuelab: { t:'nnue-lab', s:'nnue-lab.sh11235.com/t/sh11235',
             d:'学習実験の記録・可視化 Web アプリ。loss カーブの重ね描き比較、lineage 連結、NNUE・エンジンバイナリの管理。',
             url:'https://nnue-lab.sh11235.com/t/sh11235' },
  ramu:    { t:'ラム将棋', s:'ramu-shogi.sh11235.com',
             d:'Web・デスクトップ将棋アプリ。rshogi を WASM で内蔵。CSA 対局の live 観戦ビューアー付き。',
             url:'https://ramu-shogi.sh11235.com/' },
  csasrv:  { t:'csa-server', s:'rshogi/crates/rshogi-csa-server-*',
             d:'CSA プロトコルの対局サーバー。本番は Cloudflare Workers + R2 で稼働中。TCP 版フロントもある。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-csa-server' },
  csacli:  { t:'csa-client', s:'rshogi/crates/rshogi-csa-client',
             d:'CSA 対局クライアント。USI エンジンを CSA プロトコルへ橋渡しし、自前サーバーにも floodgate にも接続できる。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-csa-client' },
  xtask:   { t:'xtask', s:'rshogi/crates/xtask',
             d:'ビルドタスク集。cargo xtask build --edition で、HalfKP / LayerStack など NNUE アーキテクチャ別の推論 edition バイナリをビルドする。preset は rshogi-core の Cargo.toml に edition-* feature として定義。',
             url:'https://github.com/SH11235/rshogi/blob/main/crates/xtask/src/main.rs' },
  usi:     { t:'rshogi-usi', s:'rshogi/crates/rshogi-usi',
             d:'USI (Universal Shogi Interface) プロトコルの実装。GUI や対局ツールとエンジンをつなぐ入出力層。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-usi' },
  book:    { t:'rshogi-book', s:'rshogi/crates/rshogi-book',
             d:'定跡データベースの読み書きと参照。book_* ツール群が作った定跡を engine が対局で引く。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-book' },
  tcpfr:   { t:'csa-server-tcp', s:'rshogi/crates/rshogi-csa-server-tcp',
             d:'csa-server の TCP フロントエンド。ローカルや自前サーバーで CSA 対局場を立てるときの実行形。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-csa-server-tcp' },
  wrkfr:   { t:'csa-server-workers', s:'rshogi/crates/rshogi-csa-server-workers',
             d:'csa-server の Cloudflare Workers フロントエンド。本番の対局サーバーとして稼働し、棋譜を R2 に保存する。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-csa-server-workers' },
  csaproto:{ t:'rshogi-csa', s:'rshogi/crates/rshogi-csa',
             d:'CSA プロトコル (対局通信規約) のコア実装。csa-client と csa-server の両方がこれを共有する。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-csa' },
  core:    { t:'rshogi-core', s:'rshogi/crates/rshogi-core',
             d:'エンジン本体。ビットボードの盤面表現、Alpha-Beta 探索、NNUE 評価関数の推論、置換表、Lazy SMP をこの crate が担う。',
             url:'https://github.com/SH11235/rshogi/tree/main/crates/rshogi-core' },
  fg:      { t:'floodgate', s:'wdoor.c.u-tokyo.ac.jp',
             d:'外部のコンピュータ将棋レーティング対局場。rshogi は csa-client 経由で参加する。',
             url:'http://wdoor.c.u-tokyo.ac.jp/shogi/floodgate.html' },
};
const pop = document.getElementById('pop');
let popOpen = false;
function showPop(n) {
  const inf = INFO[n.info]; if (!inf) return;
  document.getElementById('popT').textContent = inf.t;
  document.getElementById('popS').textContent = inf.s;
  document.getElementById('popD').textContent = inf.d;
  const lk = document.getElementById('popL');
  lk.textContent = inf.url.replace(/^https?:\/\//, '') + ' ↗';
  lk.href = inf.url;
  // クリック元の画面座標に錨止め (右側のノードは左に開く)
  const r = svg.getBoundingClientRect(), wrapR = svg.parentElement.getBoundingClientRect();
  const sx = r.left - wrapR.left + n.x / 980 * r.width;
  const sy = r.top - wrapR.top + (n.y - 30) / 470 * r.height;
  const left = n.x > 560;
  pop.style.left = (left ? sx - 316 : sx + 22) + 'px';
  pop.style.top = Math.max(8, sy - 40) + 'px';
  pop.style.transformOrigin = left ? '100% 22%' : '0% 22%';
  pop.classList.add('on');
  pop.style.transition = reduced ? 'none' : 'opacity .22s ease-out, transform .3s cubic-bezier(.2,1.1,.3,1)';
  pop.style.opacity = 1; pop.style.transform = 'scale(1)';
  popOpen = true;
}
function hidePop() {
  if (!popOpen) return;
  pop.classList.remove('on');
  pop.style.opacity = 0; pop.style.transform = 'scale(.62)';
  popOpen = false;
}
document.getElementById('popX').addEventListener('click', hidePop);
document.addEventListener('click', e5 => { if (popOpen && !pop.contains(e5.target)) hidePop(); });
document.addEventListener('keydown', e6 => { if (e6.key !== 'Escape') return; if (popOpen) hidePop(); else if (cur > 0) nav(cur - 1, null); });
pop.addEventListener('click', e7 => e7.stopPropagation());

function nav(target, originPt) {
  if (target === cur) return;
  hidePop();
  const down = target > cur;                       // 深く潜る方向か
  const now = performance.now();
  pendingStagger = [];
  for (let li = 0; li < LEVELS.length; li++) {
    const d = drv[li];
    if (li === target) {
      if (originPt) d.origin = originPt;
      d.fade.t = 1; d.auxO.t = 1; d.zoom.t = 1;
      const ranks = LEVELS[li].nodes
        .map((n2, i) => ({ i, dd: Math.hypot(n2.x - d.origin.x, n2.y - d.origin.y) }))
        .sort((a, b) => a.dd - b.dd);
      ranks.forEach(({ i }, rank) => {
        const s = d.nodeP[i];
        if (reduced) { s.t = 1; return; }
        pendingStagger.push({ spring: s, at: now + rank * 26, to: 1 });
      });
    } else {
      d.fade.t = 0; d.auxO.t = 0;
      // 空間的整合: 潜るなら手前へ抜け (拡大)、戻るなら奥へ縮む
      d.zoom.t = li < target ? 1.55 : .62;
      d.nodeP.forEach(s => { s.t = li > target ? 0 : s.t; });
    }
  }
  cur = target;
  renderCrumb();
  const hash = ['', '#rshogi', '#rshogi-tools'][target];
  if (location.hash !== hash) history.pushState(null, '', hash || location.pathname.split('#')[0]);
}

addEventListener('popstate', () => {
  const h = location.hash;
  nav(h === '#rshogi-tools' ? 2 : h === '#rshogi' ? 1 : 0, null);
});

// ── フレームループ ──
let last = performance.now();
function frame(t) {
  const dt = Math.min(.05, (t - last) / 1000); last = t;
  for (const p of pendingStagger) if (t >= p.at && p.spring.t !== p.to) p.spring.t = p.to;
  pendingStagger = pendingStagger.filter(p => p.spring.t !== p.to || Math.abs(p.spring.v - p.to) > 1e-3);
  stepSprings(dt);
  for (let li = 0; li < levelGs.length; li++) {
    const lg = levelGs[li], d = drv[li];
    const vis = d.fade.v > .005;
    lg.g.style.display = vis ? '' : 'none';
    if (!vis) continue;
    lg.g.style.opacity = Math.max(0, Math.min(1, d.fade.v));
    const z = d.zoom.v, o = d.origin;
    lg.g.setAttribute('transform', `translate(${o.x * (1 - z)},${o.y * (1 - z)}) scale(${z})`);
    lg.g.style.pointerEvents = (li === cur && d.fade.v > .35) ? '' : 'none';
    lg.aux.style.opacity = Math.max(0, Math.min(1, d.auxO.v));
    lg.nds.forEach(({ n, ng }, i) => {
      const p = d.nodeP[i].v;
      const x = o.x + (n.x - o.x) * p, y = o.y + (n.y - o.y) * p;
      const sc = .55 + .45 * p;
      ng.setAttribute('transform', `translate(${x},${y}) scale(${sc})`);
      ng.style.opacity = Math.max(0, Math.min(1, p));
    });
  }
  requestAnimationFrame(frame);
}

// ── パンくず ──
const crumbEl = document.getElementById('crumb');
function renderCrumb() {
  const names = ['全体', 'rshogi', 'tools'];
  let html = '';
  for (let i = 0; i <= (cur === 0 ? 0 : cur); i++) {
    if (i > 0) html += '<span class="sep">›</span>';
    html += i === cur ? `<span class="cur">${names[i]}</span>` : `<a data-lv="${i}">${names[i]}</a>`;
  }
  crumbEl.innerHTML = cur === 0 ? '' : html;
  crumbEl.querySelectorAll('a').forEach(a => a.addEventListener('click', () => nav(+a.dataset.lv, null)));
}

renderCrumb();
if (location.hash === '#rshogi') nav(1, null);
else if (location.hash === '#rshogi-tools') nav(2, null);
requestAnimationFrame(frame);
</script>
