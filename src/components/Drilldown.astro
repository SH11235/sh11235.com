      <marker id="tp" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7.5" markerHeight="7.5" orient="auto-start-reverse"><path d="M2 1.5 L8 5 L2 8.5" fill="none" stroke="#6f695f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></marker>
      <marker id="tps" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7.5" markerHeight="7.5" orient="auto-start-reverse"><path d="M2 1.5 L8 5 L2 8.5" fill="none" stroke="#B33A2B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></marker>
    </defs>
  </svg>
  <div class="pop" id="pop" role="dialog" aria-modal="false">
    <button class="x" id="popX" aria-label="閉じる">✕</button>
    <h4 id="popT"></h4>
    <div class="sub" id="popS"></div>
    <p id="popD"></p>
    <a class="lk" id="popL" href="#" target="_blank" rel="noopener"></a>
