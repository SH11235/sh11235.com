 // L1: rshogi crates — rshogi-core を中心に置き、依存が中心へ集まる放射状
 { name: 'rshogi', origin:'rshogi',
   washes: [ { r:118, cx:430, cy:300, cls:'wash' } ],
   nodes: [
     { id:'core',   x:430, y:300, t:'rshogi-core', m:'\u76e4\u9762\u30fb\u63a2\u7d22\u30fbNNUE \u63a8\u8ad6', big:true, cnr:[ -85,-32,85,28 ], info:'core' },
