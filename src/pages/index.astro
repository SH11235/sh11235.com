---
import Base from '../layouts/Base.astro';
---
<Base title="SH11235" description="将棋にまつわるソフトウェアを Rust で自作しています。将棋エンジン rshogi、CSA 対局サーバー、将棋アプリ ラム将棋、NNUE 学習ツール tatara など。">

<div class="home">
  <h1>SH11235</h1>
  <p class="lead">将棋にまつわるソフトウェアを Rust で自作しています。</p>
  <!-- （user: 自己紹介・スタンスなど温度感のある段落をここに） -->

  <nav class="doors">
    <a class="door main" href="/shogi/">
      <span class="dt">将棋ソフトウェア</span>
      <span class="dd2">エンジン・対局サーバー・GUI・NNUE 学習ツールの相関図</span>
    </a>
    <a class="door" href="/articles/">
      <span class="dt">記事</span>
      <span class="dd2">開発の記録</span>
    </a>
    <a class="door" href="https://github.com/SH11235">
      <span class="dt">GitHub</span>
      <span class="dd2">github.com/SH11235</span>
    </a>
  </nav>
</div>

</Base>

<style>
  .home { max-width: 720px; margin: 0 auto; padding: 72px 44px 90px; text-align: center; }
  .home h1 { font-family: var(--mincho); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 600; letter-spacing: .14em; }
  .home .lead { font-size: .9rem; color: #45403A; margin-top: 14px; }
  .doors { margin-top: 48px; display: grid; gap: 16px; text-align: left; }
  .door { display: block; border: 1px solid var(--faint); padding: 18px 22px; text-decoration: none; transition: border-color .15s ease-out; }
  .door:hover { border-color: var(--shu); }
  .door:active { transform: scale(.985); }
  .door.main { border-color: var(--ink); }
  .door .dt { font-family: var(--mincho); font-size: 17px; letter-spacing: .1em; font-weight: 600; display: block; }
  .door:hover .dt { color: var(--shu); }
  .door .dd2 { font-family: var(--mono); font-size: 11px; color: var(--mute); display: block; margin-top: 4px; }
  @media (prefers-reduced-motion: reduce) { .door { transition: none; } .door:active { transform: none; } }
</style>
